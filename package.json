{
  "name": "scene",
  "version": "0.0.1",
  "description": "DOM-first cinematic effects engine for the web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "eslint packages --ext .ts --fix",
    "format": "turbo run format",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "cursor:rules:sync": "node scripts/sync-cursor-rules.mjs",
    "cursor:rules:clean": "rm -f .cursor/rules/__legacy_mdc__*.mdc"
  },
  "keywords": [
    "webgpu",
    "effects",
    "dom",
    "animation",
    "canvas"
  ],
  "author": "Mattie Lee",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mattiel/scene.git"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@webgpu/types": "^0.1.52",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.7.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
